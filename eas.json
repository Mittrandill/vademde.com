{
  "cli": {
    "version": ">= 20.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      },
      "ios": {
        "ascAppId": "6796449470"
      }
    },
    "alpha": {
      "android": {
        "track": "alpha",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      },
      "ios": {
        "ascAppId": "6796449470"
      }
    }
  }
}
